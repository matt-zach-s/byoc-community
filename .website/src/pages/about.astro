---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="More on BYOC">
  <Header />

  <main class="flex-1">
    <!-- Hero Section - Dark with terminal vibe -->
    <section class="bg-dark-section py-16 md:py-24">
      <div class="container">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="font-mono text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
            <span class="text-[var(--color-accent-500)]">&gt;</span> BYOC<span class="blinking-cursor">_</span>
          </h1>
          <p class="text-xl md:text-2xl text-slate-300 max-w-2xl mx-auto">
            Deploy software in your customer's cloud account.
            <br class="hidden md:block" />
            Keep data where it belongs.
          </p>
        </div>
      </div>
    </section>

    <!-- What is BYOC - Benefits Cards -->
    <section class="bg-dark-section pb-16">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Data Sovereignty -->
            <div class="terminal-card">
              <div class="terminal-card-number">[01]</div>
              <div class="terminal-card-title">Data Sovereignty</div>
              <p class="terminal-card-description">
                Customer data never leaves their cloud account. Simplifies SOC 2, HIPAA, GDPR, and FedRAMP compliance.
              </p>
            </div>

            <!-- No Lock-in -->
            <div class="terminal-card">
              <div class="terminal-card-number">[02]</div>
              <div class="terminal-card-title">No Vendor Lock-in</div>
              <p class="terminal-card-description">
                Customers maintain control over their infrastructure. They can switch vendors or self-host if needed.
              </p>
            </div>

            <!-- Cost Transparency -->
            <div class="terminal-card">
              <div class="terminal-card-number">[03]</div>
              <div class="terminal-card-title">Cost Transparency</div>
              <p class="terminal-card-description">
                Infrastructure costs appear on the customer's cloud bill. Clear budgeting, easy optimization.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Architecture Section -->
    <section class="bg-[var(--color-slate-50)] py-16 md:py-20">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <h2 class="hacker-heading text-2xl md:text-3xl font-bold text-[var(--color-text-primary)] mb-8">
            architecture_patterns<span class="blinking-cursor">_</span>
          </h2>

          <!-- Pattern Tabs -->
          <div class="flex flex-wrap gap-2 mb-6">
            <button
              class="arch-tab active px-4 py-2 font-mono text-sm rounded-lg border-2 transition-all"
              data-pattern="control-plane"
            >
              [01] Control / Data Plane
            </button>
            <button
              class="arch-tab px-4 py-2 font-mono text-sm rounded-lg border-2 transition-all"
              data-pattern="agent"
            >
              [02] Agent-Based
            </button>
            <button
              class="arch-tab px-4 py-2 font-mono text-sm rounded-lg border-2 transition-all"
              data-pattern="self-hosted"
            >
              [03] Full Self-Hosted
            </button>
          </div>

          <!-- ASCII Diagrams -->
          <div class="terminal-window mb-6">
            <div class="terminal-window-header">
              <div class="terminal-window-dot red"></div>
              <div class="terminal-window-dot yellow"></div>
              <div class="terminal-window-dot green"></div>
              <div class="terminal-window-title" id="diagram-title">control-plane.txt</div>
            </div>
            <div class="terminal-window-body overflow-x-auto">
              <!-- Control Plane Diagram -->
              <pre id="diagram-control-plane" class="ascii-diagram font-mono text-xs md:text-sm leading-tight text-[var(--color-accent-400)]">
+---------------------------+
|     VENDOR CLOUD          |
|  +---------------------+  |
|  |    CONTROL PLANE    |  |
|  |  +----+ +----+ +--+ |  |
|  |  | UI | | API| |  | |  |
|  |  +--+-+ +-+--+ +--+ |  |
|  +-----|-----|---------|--+
+--------|-----|---------|--+
         |     |         |
         v     v         v
    ~~~~ SECURE CHANNEL ~~~~
         |     |         |
         v     v         v
+---------------------------+
|   CUSTOMER CLOUD          |
|  +---------------------+  |
|  |     DATA PLANE      |  |
|  | +------+ +-------+  |  |
|  | |Compute| |Storage|  |  |
|  | +------+ +-------+  |  |
|  |                     |  |
|  | * Data stays here   |  |
|  +---------------------+  |
+---------------------------+</pre>

              <!-- Agent Diagram -->
              <pre id="diagram-agent" class="ascii-diagram font-mono text-xs md:text-sm leading-tight text-[var(--color-accent-400)] hidden">
+---------------------------+
|     VENDOR CLOUD          |
|  +---------------------+  |
|  |  MANAGEMENT SERVICE |  |
|  |  +----+ +--------+  |  |
|  |  | API| | Updates|  |  |
|  |  +--^-+ +---^----+  |  |
|  +-----|-------|-------+  |
+--------|-------|----------+
         |       |
    ~~~~ | HTTPS | ~~~~
         |       |
+--------|-------|----------+
|   CUSTOMER CLOUD          |
|  +-----|-------|-------+  |
|  |     +---+---+       |  |
|  |     | AGENT |       |  |
|  |     +---+---+       |  |
|  |         |           |  |
|  |    +----v----+      |  |
|  |    |  APP    |      |  |
|  |    +---------+      |  |
|  | * Outbound only     |  |
|  +---------------------+  |
+---------------------------+</pre>

              <!-- Self-Hosted Diagram -->
              <pre id="diagram-self-hosted" class="ascii-diagram font-mono text-xs md:text-sm leading-tight text-[var(--color-accent-400)] hidden">
+---------------------------+
|   CUSTOMER CLOUD          |
|  +---------------------+  |
|  |   FULL APPLICATION  |  |
|  |  +----+ +--------+  |  |
|  |  | UI | | API    |  |  |
|  |  +----+ +--------+  |  |
|  |  +----+ +--------+  |  |
|  |  | DB | | Workers|  |  |
|  |  +----+ +--------+  |  |
|  |                     |  |
|  | * No external deps  |  |
|  | * Air-gap ready     |  |
|  +---------------------+  |
+---------------------------+

   (No vendor connection)</pre>
            </div>
          </div>

          <!-- Pattern Details -->
          <div id="pattern-details" class="p-5 bg-white border border-[var(--color-slate-200)] rounded-lg">
            <div id="detail-control-plane">
              <p class="text-sm text-[var(--color-text-secondary)] mb-3">
                Vendor operates management UI and orchestration. Customer's data plane runs workloads in their cloud.
              </p>
              <div class="text-xs font-mono space-y-1">
                <div class="text-green-600">+ Data isolation</div>
                <div class="text-green-600">+ Managed experience</div>
                <div class="text-amber-600">~ Requires secure channel</div>
              </div>
            </div>
            <div id="detail-agent" class="hidden">
              <p class="text-sm text-[var(--color-text-secondary)] mb-3">
                Lightweight agent in customer environment connects outbound to vendor services.
              </p>
              <div class="text-xs font-mono space-y-1">
                <div class="text-green-600">+ Minimal footprint</div>
                <div class="text-green-600">+ Easy updates</div>
                <div class="text-amber-600">~ Needs outbound access</div>
              </div>
            </div>
            <div id="detail-self-hosted" class="hidden">
              <p class="text-sm text-[var(--color-text-secondary)] mb-3">
                Everything runs in customer environment. No vendor infrastructure dependency.
              </p>
              <div class="text-xs font-mono space-y-1">
                <div class="text-green-600">+ Air-gap compatible</div>
                <div class="text-green-600">+ Complete control</div>
                <div class="text-amber-600">~ Higher ops burden</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      document.addEventListener('astro:page-load', () => {
        const tabs = document.querySelectorAll('.arch-tab');
        const diagrams = document.querySelectorAll('.ascii-diagram');
        const details = document.querySelectorAll('#pattern-details > div');
        const titleEl = document.getElementById('diagram-title');

        const titles: Record<string, string> = {
          'control-plane': 'control-plane.txt',
          'agent': 'agent-based.txt',
          'self-hosted': 'self-hosted.txt'
        };

        tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const pattern = tab.getAttribute('data-pattern');

            // Update tabs
            tabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');

            // Update diagrams
            diagrams.forEach(d => d.classList.add('hidden'));
            document.getElementById(`diagram-${pattern}`)?.classList.remove('hidden');

            // Update details
            details.forEach(d => d.classList.add('hidden'));
            document.getElementById(`detail-${pattern}`)?.classList.remove('hidden');

            // Update title
            if (titleEl && pattern) titleEl.textContent = titles[pattern] || '';
          });
        });
      });
    </script>

    <!-- Implementation Section -->
    <section class="bg-dark-section py-16 md:py-20">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <h2 class="font-mono text-2xl md:text-3xl font-bold text-slate-100 mb-8">
            <span class="text-[var(--color-accent-500)]">&gt;</span> implementation<span class="blinking-cursor">_</span>
          </h2>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Code Example -->
            <div class="terminal-window">
              <div class="terminal-window-header">
                <div class="terminal-window-dot red"></div>
                <div class="terminal-window-dot yellow"></div>
                <div class="terminal-window-dot green"></div>
                <div class="terminal-window-title">deploy.sh</div>
              </div>
              <div class="terminal-window-body text-sm">
                <div><span class="code-comment"># Deploy with Helm</span></div>
                <div><span class="code-command">helm</span> install myapp ./charts/byoc \</div>
                <div class="pl-4"><span class="code-flag">--set</span> cloud.provider=<span class="code-value">aws</span> \</div>
                <div class="pl-4"><span class="code-flag">--set</span> region=<span class="code-value">us-east-1</span></div>
                <div class="mt-4"><span class="code-comment"># Or use Terraform</span></div>
                <div><span class="code-command">terraform</span> apply \</div>
                <div class="pl-4"><span class="code-flag">-var</span> customer_id=<span class="code-value">acme-corp</span> \</div>
                <div class="pl-4"><span class="code-flag">-var</span> vpc_id=<span class="code-value">vpc-123abc</span></div>
              </div>
            </div>

            <!-- Deployment Methods -->
            <div class="space-y-4">
              <div class="terminal-card">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-[var(--color-slate-800)] flex items-center justify-center text-[var(--color-accent-400)]">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                  </div>
                  <div>
                    <div class="terminal-card-title text-sm">Kubernetes / Helm</div>
                    <div class="text-xs text-slate-500">For K8s-native customers</div>
                  </div>
                </div>
              </div>

              <div class="terminal-card">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-[var(--color-slate-800)] flex items-center justify-center text-[var(--color-accent-400)]">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                  </div>
                  <div>
                    <div class="terminal-card-title text-sm">Terraform / IaC</div>
                    <div class="text-xs text-slate-500">Infrastructure as code modules</div>
                  </div>
                </div>
              </div>

              <div class="terminal-card">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-[var(--color-slate-800)] flex items-center justify-center text-[var(--color-accent-400)]">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <div class="terminal-card-title text-sm">CLI / Installer</div>
                    <div class="text-xs text-slate-500">One-command setup scripts</div>
                  </div>
                </div>
              </div>

              <div class="terminal-card">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-[var(--color-slate-800)] flex items-center justify-center text-[var(--color-accent-400)]">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
                    </svg>
                  </div>
                  <div>
                    <div class="terminal-card-title text-sm">BYOC Platforms</div>
                    <div class="text-xs text-slate-500">Replicated, Nuon, etc.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Security Section -->
    <section class="bg-[var(--color-slate-50)] py-16 md:py-20">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <h2 class="hacker-heading text-2xl md:text-3xl font-bold text-[var(--color-text-primary)] mb-8">
            security_checklist<span class="blinking-cursor">_</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-4">
              <div class="hacker-checklist">
                <div class="hacker-checklist-item">
                  <span class="text-[var(--color-text-primary)]"><strong>Data Residency</strong> — Keep data in customer-specified regions</span>
                </div>
                <div class="hacker-checklist-item">
                  <span class="text-[var(--color-text-primary)]"><strong>Encryption</strong> — TLS 1.3 in transit, CMK at rest</span>
                </div>
                <div class="hacker-checklist-item">
                  <span class="text-[var(--color-text-primary)]"><strong>IAM</strong> — Least-privilege, assume-role patterns</span>
                </div>
                <div class="hacker-checklist-item">
                  <span class="text-[var(--color-text-primary)]"><strong>Audit Logs</strong> — Full API logging to customer SIEM</span>
                </div>
              </div>
            </div>

            <div class="terminal-window">
              <div class="terminal-window-header">
                <div class="terminal-window-dot red"></div>
                <div class="terminal-window-dot yellow"></div>
                <div class="terminal-window-dot green"></div>
                <div class="terminal-window-title">iam-policy.json</div>
              </div>
              <div class="terminal-window-body text-xs">
                <pre class="text-slate-300" set:html={`{
  <span class="text-amber-400">"Version"</span>: <span class="code-value">"2012-10-17"</span>,
  <span class="text-amber-400">"Statement"</span>: [{
    <span class="text-amber-400">"Effect"</span>: <span class="code-value">"Allow"</span>,
    <span class="text-amber-400">"Action"</span>: [
      <span class="code-value">"s3:GetObject"</span>,
      <span class="code-value">"s3:PutObject"</span>
    ],
    <span class="text-amber-400">"Resource"</span>: <span class="code-value">"arn:aws:s3:::*"</span>,
    <span class="text-amber-400">"Condition"</span>: {
      <span class="text-amber-400">"StringEquals"</span>: {
        <span class="code-value">"aws:PrincipalAccount"</span>: <span class="code-value">"CUSTOMER_ID"</span>
      }
    }
  }]
}`} />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- When to Use BYOC -->
    <section class="bg-dark-section py-16 md:py-20">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <h2 class="font-mono text-2xl md:text-3xl font-bold text-slate-100 mb-8">
            <span class="text-[var(--color-accent-500)]">&gt;</span> when_to_byoc<span class="blinking-cursor">_</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="terminal-card border-green-500/30">
              <div class="terminal-card-number text-green-400">// GOOD FIT</div>
              <ul class="space-y-2 text-sm text-slate-300 font-mono">
                <li class="flex items-start gap-2">
                  <span class="text-green-400">+</span>
                  <span>Strict compliance (SOC 2, HIPAA, FedRAMP)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-400">+</span>
                  <span>Sensitive data (PII, financial, healthcare)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-400">+</span>
                  <span>Enterprise customers demanding it</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-400">+</span>
                  <span>Large data volumes in customer cloud</span>
                </li>
              </ul>
            </div>

            <div class="terminal-card border-amber-500/30">
              <div class="terminal-card-number text-amber-400">// CONSIDER CAREFULLY</div>
              <ul class="space-y-2 text-sm text-slate-300 font-mono">
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">~</span>
                  <span>Small team without DevOps expertise</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">~</span>
                  <span>Rapidly changing product</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">~</span>
                  <span>Consumer-focused product</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-amber-400">~</span>
                  <span>Limited engineering resources</span>
                </li>
              </ul>
            </div>
          </div>

          <p class="mt-8 text-sm text-slate-500 font-mono text-center">
            // Building BYOC is a significant investment. Validate customer demand first.
          </p>
        </div>
      </div>
    </section>

    <!-- Contributing CTA -->
    <section class="bg-[var(--color-slate-50)] py-16">
      <div class="container">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="hacker-heading justify-center text-xl md:text-2xl font-bold text-[var(--color-text-primary)] mb-4">
            contribute<span class="blinking-cursor">_</span>
          </h2>
          <p class="text-[var(--color-text-secondary)] mb-6">
            This catalog is open source and community-driven.
          </p>
          <a
            href="https://github.com/nuonco/awesome-BYOC"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-6 py-3 bg-[var(--color-slate-900)] text-white rounded-lg font-mono hover:bg-[var(--color-slate-800)] transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span>View on GitHub</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
